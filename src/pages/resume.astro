---
import r from '../content/resume.json';
import assets from '../assets/assets.json';

const font = assets['font.ui'];
const fontCss = `@font-face{font-family:"${font.family}";src:url(${font.path}) format("truetype");font-display:swap}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{r.name} — Résumé</title>
    <meta name="description" content={`${r.name}, ${r.title}. Résumé.`} />
    <style is:inline set:html={fontCss}></style>
    <style>
      :root { color-scheme: light; }
      html { background: #16161d; }
      body { margin: 0; padding: 16px; box-sizing: border-box; font-family: "HGSS Pixel", "Courier New", monospace; font-size: 16px; line-height: 1.5; -webkit-font-smoothing: none; font-kerning: none; color: #22222c; }
      main { max-width: 52rem; margin: 0 auto; padding: 24px; background: #e9e4cf; border: 4px solid #2b2b38; box-shadow: inset 0 0 0 4px #b9b295; }
      h1 { font-size: 32px; font-weight: 400; line-height: 1.25; margin: 0; }
      p { margin: 8px 0; }
      a { color: #1c4fb0; }
      .title { color: #52525a; }
      .btn { display: flex; align-items: center; justify-content: center; min-height: 64px; box-sizing: border-box; margin: 24px 0 8px; padding: 0 24px; color: #fff; text-decoration: none; background: #d9473f; border: 3px solid #22222c; border-radius: 8px; box-shadow: 0 3px 0 #22222c; }
      .btn:hover { background: #e2574f; }
      .walk { display: inline-block; margin-top: 24px; padding: 8px 0; }
      :focus-visible { outline: 3px solid #1c4fb0; outline-offset: 3px; }
      /* Phones show an empty box for embedded PDFs, so the embed is a wide-viewport extra; the button is the primary element. */
      object { display: none; }
      @media (min-width: 900px) {
        object { display: block; width: 100%; height: 80vh; min-height: 480px; margin-top: 16px; border: 3px solid #22222c; background: #fff; }
      }
      @media (max-width: 480px) {
        body { padding: 8px; font-size: 16px; }
        main { padding: 16px; }
        h1 { font-size: 28px; }
      }
      @media print { object, .walk, .btn { display: none; } }
    </style>
  </head>
  <body>
    <main>
      <h1>{r.name}</h1>
      <p class="title">{r.title}</p>
      <a class="btn" href="/resume.pdf" download>Download PDF</a>
      <object data="/resume.pdf" type="application/pdf" aria-label={`${r.name} résumé (PDF)`}>
        <p>The PDF can't be shown here. <a href="/resume.pdf">Open the résumé PDF</a>.</p>
      </object>
      <a class="walk" href="/?open=card">Walk into the room »</a>
    </main>
  </body>
</html>
