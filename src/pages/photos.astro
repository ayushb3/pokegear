---
import { groupByPlace, captionOf, photoPath } from '../content/photos';
import assets from '../assets/assets.json';

const groups = groupByPlace();
const total = groups.reduce((n, g) => n + g.photos.length, 0);
const font = assets['font.ui'];
const fontCss = `@font-face{font-family:"${font.family}";src:url(${font.path}) format("truetype");font-display:swap}`;
type Dim = { w?: number; h?: number };
const dims = (slot: string) => assets[slot as keyof typeof assets] as Dim;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ayush Basu — Photos</title>
    <meta name="description" content={`${total} photos from places Ayush has been, grouped by country.`} />
    <style is:inline set:html={fontCss}></style>
    <style>
      :root { color-scheme: light; }
      html { background: #16161d; }
      body {
        margin: 0;
        padding: 16px;
        box-sizing: border-box;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        color: #22222c;
      }
      h1, h2, .walk {
        font-family: "HGSS Pixel", "Courier New", monospace;
        font-size: 16px;
        line-height: 1.5;
        font-weight: 400;
        -webkit-font-smoothing: none;
        font-kerning: none;
      }
      main { max-width: 70ch; margin: 0 auto; padding: 24px; background: #e9e4cf; border: 4px solid #2b2b38; box-shadow: inset 0 0 0 4px #b9b295; }
      h1 { font-size: 32px; line-height: 1.25; margin: 0; }
      h2 { font-size: 28px; margin: 32px 0 8px; padding-bottom: 4px; border-bottom: 3px solid #2f6fa8; color: #2f6fa8; }
      p { margin: 8px 0; }
      a { color: #1c4fb0; }
      .walk { display: inline-flex; align-items: center; min-height: 56px; padding: 0 24px; background: #d9473f; color: #fff; text-decoration: none; border: 3px solid #22222c; border-radius: 8px; box-shadow: 0 3px 0 #22222c; }
      .walk:hover { background: #e2574f; }
      .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
      figure { margin: 0; }
      img { display: block; width: 100%; height: auto; background: #b8b8c8; border: 2px solid #22222c; box-sizing: border-box; }
      figcaption { margin-top: 4px; color: #52525a; }
      :focus-visible { outline: 3px solid #1c4fb0; outline-offset: 3px; }
      @media (max-width: 480px) {
        body { padding: 8px; }
        main { padding: 16px; }
        h1 { font-size: 28px; }
        h2 { font-size: 16px; }
        .walk { width: 100%; box-sizing: border-box; justify-content: center; }
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Photos</h1>
      <p>{total} photos from places Ayush has been, by country.</p>
      <p><a class="walk" href="/">Walk into the room »</a></p>
      {groups.map((g) => (
        <section>
          <h2>{g.country}</h2>
          <ul class="grid">
            {g.photos.map((p) => {
              const src = photoPath(p);
              const d = dims(p.slot);
              return (
                src && (
                  <li>
                    <figure>
                      <img src={src} width={d.w} height={d.h} alt={captionOf(p)} loading="lazy" decoding="async" />
                      <figcaption aria-hidden="true">{p.caption ?? p.where}</figcaption>
                    </figure>
                  </li>
                )
              );
            })}
          </ul>
        </section>
      ))}
    </main>
  </body>
</html>
